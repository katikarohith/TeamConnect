<%- include('../partials/head', { title, page: 'teams' }) %>
<%- include('../partials/nav') %>
<main class="container py-4 py-lg-5"><section class="page-hero d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4"><div><p class="eyebrow text-primary mb-2">COLLABORATE</p><h1>Your teams</h1><p class="text-secondary mb-0">Dedicated spaces for the people and work that matter.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#joinTeamModal"><i class="bi bi-person-plus me-1"></i>Join with code</button><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTeamModal"><i class="bi bi-plus-lg me-1"></i>New team</button></div></section><div class="row g-4" id="teamGrid"><div class="col-12"><div class="empty-state">Loading teams…</div></div></div></main>
<div class="modal fade" id="createTeamModal" tabindex="-1"><div class="modal-dialog"><form id="createTeamForm" class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Create a team</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Team name</label><input class="form-control mb-3" name="name" required maxlength="80" placeholder="Design crew"><label class="form-label">Description <span class="text-secondary fw-normal">optional</span></label><textarea class="form-control" name="description" rows="3" maxlength="500" placeholder="What is this team working on?"></textarea><div class="form-text">You’ll be the owner and receive a shareable invite code.</div></div><div class="modal-footer"><button class="btn btn-light" type="button" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Create team</button></div></form></div></div>
<div class="modal fade" id="joinTeamModal" tabindex="-1"><div class="modal-dialog modal-sm"><form id="joinTeamForm" class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5">Join a team</h2><button class="btn-close" type="button" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Invite code</label><input class="form-control text-uppercase" name="inviteCode" required placeholder="A1B2C3D4E5"></div><div class="modal-footer"><button class="btn btn-primary">Join team</button></div></form></div></div>
<script src="/js/teams.js"></script>
<%- include('../partials/footer') %>
