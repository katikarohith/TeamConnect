<%- include('../partials/head', { title, page: 'profile' }) %>
<%- include('../partials/nav') %>
<main class="container py-4 py-lg-5"><section class="page-hero mb-4"><p class="eyebrow text-primary mb-2">YOUR ACCOUNT</p><h1>Profile</h1><p class="text-secondary mb-0">Make your workspace feel a little more like yours.</p></section><div class="row justify-content-center"><div class="col-lg-8"><div class="surface-card p-4 p-md-5"><form id="profileForm"><div class="d-flex flex-column flex-sm-row align-items-sm-center gap-4 mb-5"><div class="profile-image-wrap"><img id="profileImage" class="profile-image" alt="Profile image"><label class="image-edit"><i class="bi bi-camera-fill"></i><input type="file" id="profileImageInput" accept="image/*" hidden></label></div><div><h2 class="h4 mb-1" id="profileDisplayName">Your profile</h2><p class="text-secondary mb-0" id="profileEmail"></p><small class="text-secondary">PNG, JPG, WEBP, or GIF · max 5 MB</small></div></div><div class="mb-4"><label class="form-label" for="profileName">Display name</label><input class="form-control form-control-lg" id="profileName" name="name" required minlength="2" maxlength="60"></div><div class="mb-4"><label class="form-label">Email address</label><input class="form-control form-control-lg" id="profileEmailInput" disabled></div><div class="d-flex justify-content-end"><button class="btn btn-primary">Save changes</button></div></form></div></div></div></main>
<script src="/js/profile.js"></script>
