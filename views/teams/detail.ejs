<%- include('../partials/head', { title, page: 'team-detail' }) %>
<%- include('../partials/nav') %>
<main class="container py-4" id="workspace" data-team-id="<%= path.startsWith('/teams/') ? path.split('/').pop() : '' %>">
  <div id="workspaceLoading" class="empty-state">Loading team workspace…</div>
  <div id="workspaceContent" class="d-none">
    <section class="workspace-header d-flex flex-column flex-lg-row justify-content-between gap-3 mb-4"><div><a href="/teams" class="back-link"><i class="bi bi-arrow-left"></i> Teams</a><div class="d-flex align-items-center gap-3 mt-2"><div class="team-icon-lg"><i class="bi bi-people-fill"></i></div><div><h1 class="mb-1" id="teamName">Team</h1><p class="text-secondary mb-0" id="teamDescription"></p></div></div></div><div class="d-flex align-items-center gap-2"><button id="summaryButton" class="btn btn-outline-primary"><i class="bi bi-stars me-1"></i>Summarize chat</button><button id="inviteButton" class="btn btn-primary d-none" data-bs-toggle="modal" data-bs-target="#inviteModal"><i class="bi bi-person-plus me-1"></i>Invite</button></div></section>
    <div id="summaryPanel" class="alert ai-panel d-none mb-4"><div class="d-flex justify-content-between"><strong><i class="bi bi-stars me-2"></i>Conversation summary</strong><button type="button" class="btn-close" id="closeSummary"></button></div><div id="summaryText" class="mt-2"></div></div>
    <div class="row g-4"><section class="col-lg-8"><div class="chat-panel surface-card"><div class="chat-panel-head"><div><h2 class="h5 mb-1">Team chat</h2><span class="small text-secondary" id="typingText">Live conversation</span></div><label class="btn btn-light btn-sm mb-0" title="Upload chat image"><i class="bi bi-image"></i><input type="file" id="chatImageInput" accept="image/*" hidden></label></div><div id="messageList" class="message-list"></div><form id="messageForm" class="message-composer"><input class="form-control" id="messageInput" maxlength="3000" autocomplete="off" placeholder="Write a message… use @name to mention"><button class="btn btn-primary" aria-label="Send message"><i class="bi bi-send-fill"></i></button></form></div></section><aside class="col-lg-4"><div class="surface-card member-panel"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h5 mb-0">Members</h2><span class="badge text-bg-light" id="memberCount"></span></div><div id="memberList" class="member-list"></div><div class="invite-code mt-4"><span>Invite code</span><div><code id="inviteCode"></code><button id="copyInviteCode" class="btn btn-sm btn-link p-0"><i class="bi bi-copy"></i></button></div><small>Share this code so people can join directly.</small></div></div><a id="teamTasksLink" href="/tasks" class="surface-card task-shortcut d-flex align-items-center justify-content-between mt-4"><span><i class="bi bi-check2-square me-2 text-primary"></i>Manage team tasks</span><i class="bi bi-arrow-right"></i></a></aside></div>
  </div>
</main>
<div class="modal fade" id="inviteModal" tabindex="-1"><div class="modal-dialog"><form id="inviteForm" class="modal-content"><div class="modal-header"><h2 class="fs-5 modal-title">Add a teammate</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Their registered email</label><input class="form-control mb-3" type="email" name="email" required placeholder="teammate@example.com"><label class="form-label">Role</label><select class="form-select" name="role"><option value="member">Member</option><option value="admin">Admin</option></select><p class="form-text mb-0">They’ll receive an in-app invitation and get access immediately.</p></div><div class="modal-footer"><button class="btn btn-primary">Add member</button></div></form></div></div>
<div class="modal fade" id="privateChatModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content private-chat-modal"><div class="modal-header"><div><h2 class="fs-5 modal-title" id="privateChatTitle">Private message</h2><p class="small text-secondary mb-0">Only the two of you can see this conversation.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="private-message-list" id="privateMessageList"></div><form id="privateMessageForm" class="message-composer"><input id="privateMessageInput" class="form-control" maxlength="3000" autocomplete="off" placeholder="Write a private message…"><button class="btn btn-primary" aria-label="Send private message"><i class="bi bi-send-fill"></i></button></form></div></div></div>
<script src="/js/workspace.js"></script>
<%- include('../partials/footer') %>
