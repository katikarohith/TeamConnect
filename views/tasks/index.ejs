<%- include('../partials/head', { title, page: 'tasks' }) %>
<%- include('../partials/nav') %>
<main class="container py-4 py-lg-5"><section class="page-hero d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-3 mb-4"><div><p class="eyebrow text-primary mb-2">MAKE PROGRESS VISIBLE</p><h1>Tasks</h1><p class="text-secondary mb-0">Turn decisions into a shared, achievable plan.</p></div><div class="d-flex gap-2"><button class="btn btn-outline-primary" id="openAiModal"><i class="bi bi-stars me-1"></i>Plan with AI</button><button class="btn btn-primary" id="openTaskModal"><i class="bi bi-plus-lg me-1"></i>New task</button></div></section><div class="d-flex flex-wrap gap-2 align-items-center mb-4"><select id="taskTeamFilter" class="form-select filter-select"><option value="">All teams</option></select><div class="btn-group" id="statusFilter"><button class="btn btn-light active" data-status="">All</button><button class="btn btn-light" data-status="TODO">To do</button><button class="btn btn-light" data-status="IN_PROGRESS">In progress</button><button class="btn btn-light" data-status="COMPLETED">Done</button></div></div><div class="row g-3" id="taskBoard"><div class="col-12"><div class="empty-state">Loading tasks…</div></div></div></main>
<div class="modal fade" id="taskModal" tabindex="-1"><div class="modal-dialog modal-lg"><form id="taskForm" class="modal-content"><div class="modal-header"><h2 class="fs-5 modal-title" id="taskModalTitle">Create task</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><input type="hidden" name="taskId"><div class="row g-3"><div class="col-md-8"><label class="form-label">Title</label><input class="form-control" name="title" required maxlength="160" placeholder="What needs doing?"></div><div class="col-md-4"><label class="form-label">Team</label><select class="form-select" name="team" id="taskTeamSelect" required></select></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" rows="3" maxlength="2000" name="description" placeholder="Helpful context, acceptance criteria, or notes."></textarea></div><div class="col-md-4"><label class="form-label">Assignee</label><select class="form-select" name="assignedTo" id="assigneeSelect"><option value="">Unassigned</option></select></div><div class="col-md-3"><label class="form-label">Status</label><select class="form-select" name="status"><option value="TODO">To do</option><option value="IN_PROGRESS">In progress</option><option value="COMPLETED">Completed</option></select></div><div class="col-md-3"><label class="form-label">Priority</label><select class="form-select" name="priority"><option value="LOW">Low</option><option value="MEDIUM" selected>Medium</option><option value="HIGH">High</option></select></div><div class="col-md-2"><label class="form-label">Due date</label><input type="date" class="form-control" name="dueDate"></div></div></div><div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save task</button></div></form></div></div>
<div class="modal fade" id="aiTaskModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><div class="modal-header"><div><h2 class="fs-5 modal-title"><i class="bi bi-stars text-primary me-1"></i>AI task planner</h2><p class="small text-secondary mb-0">Turn a goal into practical next steps.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form id="aiTaskForm"><div class="modal-body"><label class="form-label">What are you working on?</label><textarea class="form-control" name="description" rows="4" minlength="10" required placeholder="For example: Implement secure authentication for our application."></textarea><div class="form-text">AI is optional and uses your configured backend provider.</div><div id="aiTaskResults" class="ai-task-results d-none"></div></div><div class="modal-footer"><button type="submit" class="btn btn-primary"><i class="bi bi-magic me-1"></i>Generate subtasks</button></div></form></div></div></div>
<script src="/js/tasks.js"></script>
<%- include('../partials/footer') %>
